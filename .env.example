# =====================================================================
# Neon Postgres — settes AUTOMATISK når Neon kobles til prosjektet i Vercel
# (Storage → Neon). Lokalt: `vercel env pull .env.local`.
# DATABASE_URL er poolet (appen); DATABASE_URL_UNPOOLED brukes til migrasjoner.
# =====================================================================
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# =====================================================================
# Innlogging (Better Auth)
# BETTER_AUTH_SECRET: lang tilfeldig streng (`openssl rand -base64 32`).
# ALLOWED_EMAILS: kommaseparert — bare disse kan lage konto.
# NEXT_PUBLIC_APP_URL: kanonisk adresse (passkeys/Face ID er knyttet til domenet).
# =====================================================================
BETTER_AUTH_SECRET=
ALLOWED_EMAILS=deg@eksempel.no,samboer@eksempel.no
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Vercel Blob (private dokumenter) — settes automatisk når Blob-lagringen
# er koblet til prosjektet.
# =====================================================================
BLOB_READ_WRITE_TOKEN=

# =====================================================================
# AI (valgfritt — appen fungerer uten). Handleliste-sortering og «Fra tekst».
# Samme nøkkel som Hyttekompis.
# =====================================================================
ANTHROPIC_API_KEY=

# =====================================================================
# Web Push (valgfritt). Generer med: npx web-push generate-vapid-keys
# =====================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://familiesamarbeid.vercel.app
