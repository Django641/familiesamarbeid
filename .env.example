# =====================================================================
# Supabase — settes AUTOMATISK når Supabase legges til via
# Vercel → Storage / Marketplace → Supabase og kobles til prosjektet.
# Lokalt: kopier verdiene fra Vercel (`vercel env pull .env.local`).
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kun server (cron-synk av kalendere, ICS-feed, push-utsending). ALDRI i klientkode.
SUPABASE_SECRET_KEY=

# =====================================================================
# Kanonisk app-URL. Brukes i e-postlenker (bekreftelse, reset) og
# kalender-abonnementslenker. Lokalt: http://localhost:3000
# =====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# AI (valgfritt — appen fungerer uten). Brukes til handleliste-sortering
# og «Lim inn tekst → hendelser» i kalenderen. Samme nøkkel som Hyttekompis.
# =====================================================================
ANTHROPIC_API_KEY=

# =====================================================================
# Vercel Cron — beskytter /api/cron/*. Vercel sender automatisk
# «Authorization: Bearer $CRON_SECRET». Lag en lang tilfeldig streng.
# =====================================================================
CRON_SECRET=

# =====================================================================
# Web Push (valgfritt). Generer med: npx web-push generate-vapid-keys
# =====================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deg@eksempel.no
